# apps/web — copie para .env e preencha.
# Em produção, estas vars vivem no painel do Vercel (Production / Preview / Development).

NODE_ENV=development

# ─── Banco (Neon) ─────────────────────────────────────────────────────────────
# Use SEMPRE o host com sufixo "-pooler": o Vercel é serverless e sem o pooler
# o Neon estoura o limite de conexões.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Clerk (auth) ─────────────────────────────────────────────────────────────
# Dashboard → API Keys. Instância Development para dev/homolog, Production para prod.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Dashboard → Webhooks → endpoint /api/webhooks/clerk (user.created, user.updated)
CLERK_WEBHOOK_SECRET=whsec_xxx
# Dashboard → JWT Templates. O nome do template tem que bater com o valor abaixo,
# senão o login do app desktop não fecha.
CLERK_DESKTOP_JWT_TEMPLATE=desktop
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=desktop

# ─── Stripe ───────────────────────────────────────────────────────────────────
# sk_test_ em dev/homolog, sk_live_ em produção.
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Webhooks → endpoint /api/webhooks/stripe. Cada ambiente tem o seu.
# Eventos: checkout.session.completed, invoice.paid, invoice.payment_failed,
#          customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Price IDs. ATENÇÃO: os de test NÃO funcionam em live — recrie os produtos no
# modo live e troque os 6 valores.
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PROFESSIONAL=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
STRIPE_PRICE_PACK_50=price_xxx
STRIPE_PRICE_PACK_100=price_xxx
STRIPE_PRICE_PACK_200=price_xxx

# ─── Créditos (regra de negócio) ──────────────────────────────────────────────
COST_PER_APPLICATION=1
CREDIT_COST_PER_QUESTION=0.2
CREDIT_COST_MAX_PER_APPLICATION=3

# ─── E-mail transacional (Resend) ─────────────────────────────────────────────
# O domínio precisa estar verificado (SPF + DKIM no DNS). Sem verificar, o Resend
# só entrega ao dono da conta — use onboarding@resend.dev para testar.
RESEND_API_KEY=re_xxx
EMAIL_FROM=nao-responda@seudominio.com.br

# ─── OpenAI (análise de currículo) ────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4.1-mini

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Projeto apliquefy-web. Sem DSN o SDK fica inerte — dev local pode deixar vazio.
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
# Só para upload de source map no build. Nunca entra no bundle.
SENTRY_AUTH_TOKEN=

# ─── URLs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
