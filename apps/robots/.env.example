# apps/robots — o engine NÃO lê .env em execução normal.
#
# Em produção todas estas vars são injetadas pelo app desktop no spawn do processo
# (electron/services/rpa-process-service.ts → buildEnv). Este arquivo serve só para
# rodar o engine standalone em debug:
#
#   set -a && source .env && uv run python -m rpa_engine

# ─── Obrigatórias ─────────────────────────────────────────────────────────────
# Bearer efêmero exigido em toda request ao engine. Sem ele o processo nem sobe.
RPA_AUTH_TOKEN=dev-token
# userData do Electron: sessões capturadas e PDFs. Default: ~/.apliquefy
RPA_USER_DATA_DIR=

# ─── Callback para a API web ──────────────────────────────────────────────────
APLIQUEFY_WEB_URL=http://localhost:3000
# Token Clerk do usuário; o engine usa para registrar candidatura e debitar crédito.
APLIQUEFY_WEB_TOKEN=

# ─── Agente de visão ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
# gpt-4o-mini é fraco para o loop de navegação do browser-use.
OPENAI_MODEL=gpt-4.1-mini

# ─── Créditos ─────────────────────────────────────────────────────────────────
COST_PER_APPLICATION=1

# ─── Browser / debug ──────────────────────────────────────────────────────────
# Chrome real evita detecção de automação. Vazio => Chromium empacotado.
RPA_BROWSER_CHANNEL=chrome
# headless derruba a sessão do LinkedIn/InfoJobs — só para debug isolado.
RPA_HEADLESS=false
# Atrasa cada ação em N ms para acompanhar a olho.
RPA_SLOWMO=0
RPA_DEVTOOLS=false

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Injetadas pelo desktop. Sem DSN o SDK não inicializa (comportamento desejado em dev).
SENTRY_DSN_RUNNER=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
SENTRY_USER_ID=
