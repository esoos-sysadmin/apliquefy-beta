# apps/robots — o engine NÃO lê .env em execução normal.
#
# Em produção todas estas vars são injetadas pelo app desktop no spawn do processo
# (electron/services/rpa-process-service.ts → buildEnv). Este arquivo serve só para
# rodar o engine standalone em debug:
#
#   set -a && source .env && uv run python -m rpa_engine

# ─── Obrigatórias ─────────────────────────────────────────────────────────────
# Bearer efêmero exigido em toda request ao engine. Sem ele o processo nem sobe.
RPA_AUTH_TOKEN=dev-token
# userData do Electron: sessões capturadas e PDFs. Default: ~/.apliquefy
RPA_USER_DATA_DIR=

# ─── Callback para a API web ──────────────────────────────────────────────────
APLIQUEFY_WEB_URL=http://localhost:3000
# Token Clerk do usuário; o engine usa para registrar candidatura e debitar crédito.
APLIQUEFY_WEB_TOKEN=

# ─── Agente de visão ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
# gpt-4o-mini é fraco para o loop de navegação do browser-use.
OPENAI_MODEL=gpt-4.1-mini

# ─── Créditos ─────────────────────────────────────────────────────────────────
COST_PER_APPLICATION=1

# ─── Browser / debug ──────────────────────────────────────────────────────────
# Mostra a janela do Chrome na tela (por padrão ela fica fora da tela).
RPA_SHOW_BROWSER=false
# headless derruba a sessão do LinkedIn/InfoJobs — só para debug isolado.
RPA_HEADLESS=false
# Atrasa cada ação em N ms para acompanhar a olho.
RPA_SLOWMO=0
RPA_DEVTOOLS=false

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Injetadas pelo desktop. Sem DSN o SDK não inicializa (comportamento desejado em dev).
SENTRY_DSN_RUNNER=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
SENTRY_USER_ID=

# ─── Worker da nuvem (python -m rpa_engine.cloud) — docs/impl-sdd-nuvem.md §11 ─
# Também usa APLIQUEFY_WEB_URL, OPENAI_API_KEY e OPENAI_MODEL acima. Obrigatórias: APLIQUEFY_WEB_URL e
# WORKER_API_TOKEN (sem elas o worker sai com exit 1). Sem as BROWSER_PROVIDER_* só o envio fica desligado.
# Igual ao WORKER_API_TOKEN da web.
WORKER_API_TOKEN=
# Gravado em lockedBy. Vazio = hostname.
WORKER_ID=
# Envios simultâneos.
WORKER_CONCURRENCY=2
BROWSER_PROVIDER_API_KEY=
BROWSER_PROVIDER_PROJECT_ID=
# ATS que usam proxy residencial (aceita: greenhouse, lever, ashby).
ATS_PROXY=greenhouse,ashby
# ATS que o worker envia; pausa um ATS sem deploy. Adapters: greenhouse, lever, ashby;
# agente genérico: workable, recruitee, breezy, teamtailor, quickin.
SUPPORTED_ATS=greenhouse
# Opcional: sem token a descoberta via Apify (LinkedIn) é pulada.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-job-search
DISCOVERY_INTERVAL_HOURS=24
# Espera pelo usuário no handoff; 0 desliga (desafio vira falha direta).
HANDOFF_TIMEOUT_MIN=10
# O worker copia para SENTRY_DSN_RUNNER; sem DSN o SDK não inicializa.
SENTRY_DSN=
