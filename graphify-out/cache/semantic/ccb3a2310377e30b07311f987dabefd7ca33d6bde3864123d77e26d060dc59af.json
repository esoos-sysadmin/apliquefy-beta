{"nodes": [{"id": "docs_ai_claude_apliquefy", "label": "Apliquefy Platform", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Job-application automation platform: user configures parameters (resume, filters, daily limits) on the web panel; a local desktop agent runs applications on LinkedIn and InfoJobs in real time while the machine is on. The two environments communicate via REST API and a Clerk-based session."}, {"id": "docs_ai_claude_monorepo", "label": "Turborepo Monorepo (npm workspaces)", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_apps_web", "label": "apps/web (Next.js panel + API)", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_apps_desktop", "label": "apps/desktop (Electron runner)", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_packages_database", "label": "packages/database (Prisma + PostgreSQL)", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_clerk_auth", "label": "Clerk Authentication", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_desktop_auth_flow", "label": "Desktop Authentication Flow", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop opens a Clerk /login popup BrowserWindow with redirect_url=/desktop-auth/success; after login it detects the redirect via did-navigate, fetches the token via /api/desktop-auth/session (cookie exchange) and closes the window."}, {"id": "docs_ai_claude_credits_system", "label": "Credits System", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each application consumes credits per CreditWeight.stage; plans grant monthly credits via Stripe webhook customer.subscription.updated; one-off Checkout purchases credit instantly; failed applications auto-refund."}, {"id": "docs_ai_claude_stripe_billing", "label": "Stripe Billing Integration", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ai_claude_service_controller_pattern", "label": "Service-Controller Pattern (Zod boundary)", "file_type": "rationale", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict separation between transport (Controllers) and business logic (Services). Each backend module follows Zod schema -> Controller -> Service. Zod validates at every external boundary; the AI generates the boilerplate 'casca' while the developer implements the business/RPA 'alma'."}, {"id": "docs_ai_claude_prisma_models", "label": "Prisma Data Models", "file_type": "concept", "source_file": "Docs/ai/claude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core models: User, Resume (JSONB), Campaign, CampaignLinkedin/CampaignInfojobs (1:1), Job, JobApplication, Report, Transaction, CreditWeight, WebhookEvent (Stripe idempotency)."}, {"id": "docs_ai_claude_linked