# packages/database — usado pelo Prisma CLI (migrate, studio, seed).
# O runtime da aplicação lê o DATABASE_URL do próprio app (apps/web/.env).

NODE_ENV=development

# Neon. Para o Prisma CLI, prefira a connection string DIRETA (sem "-pooler"):
# migrations com DDL não funcionam bem através do pooler.
DATABASE_URL=postgresql://user:pass@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
