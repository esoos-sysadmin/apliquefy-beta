enum IjContract {
  clt
  autonomo
  pj
  cooperado
  jovem_aprendiz
  estagio
  temporario
  trainee
  outros

  @@map("ij_contract")
}

enum IjSchedule {
  periodo_integral
  parcial_manha
  parcial_tarde
  parcial_noite
  noturno

  @@map("ij_schedule")
}

enum IjSeniority {
  estagiario
  operacional
  auxiliar
  assistente
  trainee
  tecnico
  analista
  encarregado
  supervisor
  consultor
  especialista
  coordenador
  gerente
  diretor

  @@map("ij_seniority")
}

enum IjPcd {
  auditiva
  fisica
  visual
  mental
  reabilitados
  psicossocial
  fala
  intelectual
  tea

  @@map("ij_pcd")
}

enum TransactionType {
  PURCHASE
  USAGE
  BONUS
  REFUND
  SUBSCRIPTION_CREDIT
  RESET
}

// ======================= MODELS =======================

model User {
  id                   String    @id
  email                String    @unique @db.VarChar
  password             String?   @db.VarChar
  role                 UserRole  @default(user)
  gatewayCustomerId    String?   @unique @map("gateway_customer_id") @db.VarChar
  credits              Int       @default(0)
  planTier             String    @default("free") @map("plan_tier") @db.VarChar
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id") @db.VarChar
  subscriptionStatus   String?   @map("subscription_status") @db.VarChar
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamp
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos Inversos
  resumes           Resume[]
  campaigns         Campaign[]
  jobApplications   JobApplication[]
  transaction       Transaction[]

  @@map("users")
}

model Transaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id")
  amount         Int
  type           TransactionType
  reference_id   String
  description    String?
  idempotencyKey String?         @unique @map("idempotency_key") @db.VarChar
  metadata       Json?
  created_at     DateTime        @default(now())

  //Relacionamentos
  user User? @relation(fields: [userId], references: [id])

  @@map("Transaction")
}

model Resume {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id")
  title        String   @db.VarChar
  personalInfo Json?    @map("personal_info") // jsonb no postgres
  education    Json? // jsonb
  experience   Json? // jsonb
  skills       Json? // jsonb
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos
  user      User      @relation(fields: [userId], references: [id])
  campaigns Campaign[]

  @@map("resumes")
}

model Campaign {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId   String   @map("resume_id") @db.Uuid
  userId     String   @map("user_id")
  name       String   @db.VarChar
  platform   Platform
  status     status_campaign   @default(inactive)
  dailyLimit Int?      @default(50) @map("daily_limit")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos
  resume Resume @relation(fields: [resumeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  // Configurações específicas (1:1 Opcional)
  linkedinConfig CampaignLinkedin?
  infojobsConfig CampaignInfojobs?

  jobApplications JobApplication[]
  jobs            Job[]
  reports         Report[]

  @@map("campaigns")
}

model CampaignLinkedin {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String           @unique @map("campaign_id") @db.Uuid
  searchTerms  String?          @map("search_terms") @db.VarChar
  locationTerm String?          @map("location_term") @db.VarChar
  sortBy       LinkedinSort?    @default(relevant) @map("sort_by")
  datePosted   LinkedinDate?    @default(any) @map("date_posted")

  // Arrays para Multi-select
  expLevel     LinkedinExp[]     @map("exp_level")
  jobType      LinkedinJobType[] @map("job_type")
  remoteFilter LinkedinRemote[]  @map("remote_filter")

  // Relacionamentos
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("campaign_linkedin")
}

model CampaignInfojobs {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId    String          @unique @map("campaign_id") @db.Uuid
  searchTerms   String?         @map("search_terms") @db.VarChar
  locationState BrazilState?    @map("location_state")
  kmDeVoce      IjRadius?       @default(km_25) @map("km_de_voce")
  salaryFilter  IjSalary?       @map("salary_filter")
  datePosted    IjDatePosted?   @map("date_posted")

  // Arrays para Multi-select
  workModels      IjWorkModel[] @map("work_models")
  jobAreas        IjJobArea[]   @map("job_areas")
  contractTypes   IjContract[]  @map("contract_types")
  workSchedules   IjSchedule[]  @map("work_schedules")
  seniorityLevels IjSeniority[] @map("seniority_levels")
  pcdTypes        IjPcd[]       @map("pcd_types")

  // Relacionamentos
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("campaign_infojobs")
}

model Job {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId           String?   @map("campaign_id") @db.Uuid
  link                 String?   @unique @db.VarChar
  companyName          String?   @map("company_name") @db.VarChar
  position             String?   @db.VarChar
  expirationDate       DateTime? @map("expiration_date") @db.Timestamp
  numberOfApplications Int?      @default(0) @map("number_of_applications")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("jobs")
}

model Report {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId           String?  @map("campaign_id") @db.Uuid
  totalJobsApplications Int     @default(0) @map("total_jobs_applications")
  successApplications  Int      @default(0) @map("success_applications")
  failApplications     Int      @default(0) @map("fail_applications")
  creditsUsed          Int      @default(0) @map("credits_used")
  creditsRefund        Int      @default(0) @map("credits_refund")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("reports")
}

model JobApplication {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String?    @map("campaign_id") @db.Uuid
  userId      String?    @map("user_id")
  platform    Platform?
  companyName String?    @map("company_name") @db.VarChar
  jobTitle    String?    @map("job_title") @db.VarChar
  jobUrl      String?    @unique @map("job_url") @db.VarChar
  status      AppStatus? @default(pending)
  errorLog    String?    @map("error_log") // text
  appliedAt   DateTime?  @map("applied_at") @db.Timestamp
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamp

  // Relacionamentos
  campaign Campaign?     @relation(fields: [campaignId], references: [id])
  user     User?         @relation(fields: [userId], references: [id])

  // Índices
  @@index([userId, status])
  @@index([campaignId])
  @@map("job_applications")
}

// ======================= BILLING & CREDITS =======================

model CreditWeight {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stage  String @unique @db.VarChar
  weight Float
  label  String @db.VarChar

  @@map("credit_weights")
}

model WebhookEvent {
  id          String   @id @db.VarChar
  type        String   @db.VarChar
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamp

  @@map("webhook_events")
}
