}

enum IjDatePosted {
  hoje
  ultimos_3_dias
  ultima_semana
  ultimos_15_dias
  ultimo_mes

  @@map("ij_date_posted")
}

enum IjJobArea {
  administracao
  agricultura_pecuaria_veterinaria
  alimentacao_gastronomia
  arquitetura_decoracao_design
  artes
  auditoria
  ciencias_pesquisa
  comercial_vendas
  comercio_exterior
  compras
  comunicacao_tv_cinema
  construcao_manutencao
  contabil_financas_economia
  cultura_lazer_entretenimento
  educacao_ensino_idiomas
  engenharia
  estetica
  hotelaria_turismo
  industrial_producao_fabrica
  informatica_ti_telecomunicacoes
  juridica
  logistica
  marketing
  meio_ambiente_ecologia
  moda
  qualidade
  quimica_petroquimica
  recursos_humanos
  saude
  seguranca
  servico_social_comunitario
  servicos_gerais
  telemarketing
  transportes

