{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["CLERK_DESKTOP_JWT_TEMPLATE", "APLIQUEFY_WEB_URL", "APLIQUEFY_WEB_TOKEN", "STRIPE_BILLING_PORTAL_URL", "CLERK_WEBHOOK_SECRET", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "STRIPE_PRICE_STARTER", "STRIPE_PRICE_PROFESSIONAL", "STRIPE_PRICE_ENTERPRISE", "STRIPE_PRICE_PACK_50", "STRIPE_PRICE_PACK_100", "STRIPE_PRICE_PACK_200", "NEXT_PUBLIC_APP_URL", "OPENAI_API_KEY", "OPENAI_MODEL", "COST_PER_APPLICATION", "RPA_HEADLESS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
